{
  "name": "@waypoint/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build -w @waypoint/contracts && prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "prestart:dev": "npm run build -w @waypoint/contracts && prisma generate",
    "start:dev": "nest start --watch",
    "pretest": "npm run build -w @waypoint/contracts && prisma generate",
    "test": "jest --rootDir . --roots src prisma --testRegex .*\\.spec\\.ts$",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:integration": "npm run build && node test/planning.integration.cjs",
    "test:postgres": "npm run build && node test/planning.integration.cjs --postgres",
    "db:seed:planning-demo": "tsx prisma/seed-planning-demo.ts",
    "db:import": "tsx prisma/import-datasets.ts",
    "test:import": "jest --rootDir . --roots prisma --testRegex dataset-import\\.spec\\.ts$",
    "test:seed": "npm run build && node test/seed.integration.cjs",
    "typecheck:prisma": "tsc --noEmit -p tsconfig.prisma.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@waypoint/contracts": "*",
    "csv-parse": "^7.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "prisma": "7.10.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3"
  }
}
