# ─────────────────────────────────────────────────────────────────────────────
# Waypoint environment template.  Copy to .env and adjust:  cp .env.example .env
# Values here are SAFE DEVELOPMENT PLACEHOLDERS. Use different secrets for any
# public deployment and never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (docker compose "db" service) ────────────────────────────────
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=change-me
# Host port Postgres is published on (for local tools / running the API outside Docker)
POSTGRES_PORT=5432

# Connection string used when running the API or Prisma OUTSIDE Docker (npm run dev:api).
# docker compose builds its own URL pointing at host "db", so this line is ignored there.
DATABASE_URL=postgresql://waypoint:change-me@localhost:5432/waypoint?schema=public

# ── API (NestJS) ────────────────────────────────────────────────────────────
# Host port for the API container (served under /api). Internal PORT stays 3000.
API_PORT=3000
NODE_ENV=production
# This placeholder is intentionally rejected by API startup; replace it before running.
# Secret used to sign JWTs — replace with a long random value (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-value
# JWT lifetime (vercel/ms format: 15m, 12h, 7d)
JWT_EXPIRES_IN=12h
# Exact browser origin allowed to call the API directly; set an HTTPS origin publicly.
# Change this when WEB_PORT changes; no comma-separated origin list is supported.
CORS_ORIGIN=http://localhost:8080
# Reserved for a future object-storage adapter; current evidence bytes live in PostgreSQL
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10
# Used by the automatic, idempotent demo seed in the Compose db-init service.
# Password given to every seeded demo account (dispatcher@, loader@, driver@, store@, store2@waypoint.lk)
SEED_DEMO_PASSWORD=waypoint-demo

# ── Web (React + nginx) ─────────────────────────────────────────────────────
# Host port for the web app
WEB_PORT=8080
# API base the browser calls. Keep /api: nginx (Docker) and Vite (dev) proxy it to the API.
# Baked into the Vite build: rebuild web after changes. Never put secrets here.
# For separate hosting, use the public HTTPS API URL including /api (no trailing slash).
VITE_API_BASE_URL=/api
